{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestedModelAlias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "reasoningEffort": {
      "type": "string",
      "enum": [
        "auto",
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "toolsEnabled": {
      "type": "boolean"
    },
    "contextLengthTokens": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10000000
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 16,
      "maximum": 1000000
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    },
    "retryPolicy": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "backoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "required": [
        "maxAttempts",
        "backoffMs"
      ],
      "additionalProperties": false
    },
    "promptTemplateDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effectiveBehavior": {
      "type": "object",
      "properties": {
        "modelReportedByHarness": {
          "type": "string",
          "maxLength": 128
        },
        "notes": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": false
    },
    "declaredUnknowns": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      }
    }
  },
  "required": [
    "requestedModelAlias",
    "toolsEnabled",
    "timeoutMs",
    "retryPolicy",
    "declaredUnknowns"
  ],
  "additionalProperties": false
}
