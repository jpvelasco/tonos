{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matrixId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "policyRevision": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-~]{0,31}$"
    },
    "gates": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "gateId",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "comparableTrialCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exclusions": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "declarationId": {
            "type": "string",
            "pattern": "^trn_trial_[0-9a-f]{64}$"
          },
          "reasonClass": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "declarationId",
          "reasonClass"
        ],
        "additionalProperties": false
      }
    },
    "winnerDeclarationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^trn_trial_[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tradeoffsAndLimitations": {
      "type": "string",
      "maxLength": 2048
    },
    "decidedAt": {
      "type": "string"
    }
  },
  "required": [
    "matrixId",
    "policyRevision",
    "gates",
    "comparableTrialCount",
    "exclusions",
    "winnerDeclarationId",
    "tradeoffsAndLimitations",
    "decidedAt"
  ],
  "additionalProperties": false
}
