{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providerProfileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "providerReportedId": {
      "type": "string",
      "maxLength": 128
    },
    "contextWindowTokens": {
      "type": "integer",
      "minimum": 512,
      "maximum": 100000000
    },
    "capabilitiesObserved": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "observedAt": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "provider-api",
        "operator-declared"
      ]
    }
  },
  "required": [
    "providerProfileId",
    "providerReportedId",
    "capabilitiesObserved",
    "observedAt",
    "source"
  ],
  "additionalProperties": false
}
