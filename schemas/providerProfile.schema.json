{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "protocolAdapterKind": {
      "type": "string",
      "enum": [
        "openai-compatible",
        "anthropic-compatible",
        "fixture"
      ]
    },
    "endpointDisplay": {
      "type": "string",
      "maxLength": 200
    },
    "servedModelAlias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "capabilityObservations": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "secretRefs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:_.-]{0,63}$"
      }
    },
    "transportPolicy": {
      "type": "object",
      "properties": {
        "connectTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      },
      "required": [
        "connectTimeoutMs",
        "requestTimeoutMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profileId",
    "protocolAdapterKind",
    "endpointDisplay",
    "servedModelAlias",
    "capabilityObservations",
    "secretRefs",
    "transportPolicy"
  ],
  "additionalProperties": false
}
